#version 450
// vk_probe.py's compute shader: v[i] = i * mul + 7 for i < n.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Data { uint v[]; };
layout(push_constant) uniform Push { uint n; uint mul; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < n)
        v[i] = i * mul + 7u;
}
