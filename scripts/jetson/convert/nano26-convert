def cpio_newc(entries):
    """A newc archive of (name, data or None for a directory), in order."""
    archive = bytearray()
    for ino, (name, data) in enumerate(entries + [('TRAILER!!!', b'')], 1):
        trailer = name == 'TRAILER!!!'
        mode = 0 if trailer else (0o100644 if data is not None else 0o040755)
        body = data or b''
        encoded = name.encode() + b'\0'
        fields = [0 if trailer else ino, mode, 0, 0, 1 if trailer or data is not None else 2,
                  0, len(body), 0, 0, 0, 0, len(encoded), 0]
        archive += b'070701' + ''.join('%08X' % v for v in fields).encode() + encoded
        archive += b'\0' * (-len(archive) % 4) + body
        archive += b'\0' * (-len(archive) % 4)
    return bytes(archive)


def install_kernel(app, kernel, partuuid):
    """The 5.10 kernel, device tree, initrd and modules, and the two boot entries."""
