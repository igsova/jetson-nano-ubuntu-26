# --- writing the new card ---

class Failed(Exception):
    pass


def run(*cmd, **kw):
    """Run a command; its output goes to the record, and to the screen if it fails
    (exits other than ok, which is 0 only unless given)."""
    quiet = kw.pop('quiet', False)
    ok = kw.pop('ok', (0,))
    log.record('$ ' + kw.pop('shown', ' '.join(cmd)))
    p = subprocess.run(list(cmd), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       universal_newlines=True, **kw)
    if p.stdout:
        log.record(p.stdout.rstrip('\n'))
    if p.returncode not in ok:
        if not quiet:
            print(p.stdout[-3000:])
        raise Failed('%s exited with %d' % (' '.join(cmd[:3]), p.returncode))
    return p.stdout


def in_root(root, *cmd):
    """A command in the new root, with a clean environment and this system's proxy, if any.
    The record shows the command without the environment: a proxy address can hold a password."""
    env = ['HOME=/root', 'PATH=/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL=C', 'TERM=dumb',
           'DEBIAN_FRONTEND=noninteractive']
    env += ['%s=%s' % (k, os.environ[k]) for k in ('http_proxy', 'https_proxy', 'no_proxy',
                                                   'HTTP_PROXY', 'HTTPS_PROXY', 'NO_PROXY') if k in os.environ]
    return run('chroot', root, '/usr/bin/env', '-i', *(env + list(cmd)),
               shown='chroot %s %s' % (root, ' '.join(cmd)))


def attrs_text(bits):
    names = {0: 'RequiredPartition', 1: 'NoBlockIOProtocol', 2: 'LegacyBIOSBootable'}
    if bits & ~(0b111 | (0xffff << 48)):
        raise Failed('partition attributes 0x%x cannot be copied' % bits)
    out = [names[b] for b in sorted(names) if bits >> b & 1]
    return ' '.join(out + ['GUID:%d' % b for b in range(48, 64) if bits >> b & 1])


def target_bytes(target):
    with open(target, 'rb') as f:
        return f.seek(0, os.SEEK_END)


def write_table(target, info, layout, disk_guid):
    """Wipe the old tables, write the new GPT with sfdisk, and read it back."""
    size = target_bytes(target)
    with open(target, 'r+b') as f:
        for offset in (0, size - 34 * SECTOR):
            f.seek(offset)
            f.write(b'\0' * 34 * SECTOR)
        f.flush()
        os.fsync(f.fileno())
    lines = ['label: gpt', 'label-id: %s' % disk_guid.upper(), 'unit: sectors',
             'first-lba: %d' % info['first'], '']
    for n in range(1, 15):
        p = layout[n]
        line = 'start=%d, size=%d, type=%s, uuid=%s, name="%s"' % (
            p['start'], p['size'], p['type'].upper(), p['uuid'].upper(), p['name'])
        if p['attrs']:
            line += ', attrs="%s"' % attrs_text(p['attrs'])
        lines.append(line)
    run('sfdisk', '--no-reread', '--no-tell-kernel', target, input='\n'.join(lines) + '\n')
    with open(target, 'rb') as f:
        new_info, new_parts = read_gpt(f)
    for n in range(1, 15):
        want, got = layout[n], new_parts.get(n)
        if not got or any(str(want[k]).lower() != str(got[k]).lower()
                          for k in ('start', 'size', 'type', 'uuid', 'name', 'attrs')):
            raise Failed('partition %d did not take: %r' % (n, got))
    if new_info['disk_guid'].lower() != disk_guid.lower():
        raise Failed('the disk GUID did not take')
    say('  table written: 14 partitions, APP %s' % human(layout[1]['size'] * SECTOR))


def copy_boot_partitions(source, target, parts):
    """p2 to p14 byte for byte, each read back from the target and compared."""
    with open(source, 'rb') as s, open(target, 'r+b') as t:
        for n in range(2, 15):
            p = parts[n]
            offset, length = p['start'] * SECTOR, p['size'] * SECTOR
            s.seek(offset)
            data = s.read(length)
            if len(data) != length:
                raise Failed('short read of %s' % p['name'])
            t.seek(offset)
            t.write(data)
            t.flush()
            os.fsync(t.fileno())
            os.posix_fadvise(t.fileno(), offset, length, os.POSIX_FADV_DONTNEED)
            t.seek(offset)
            if t.read(length) != data:
                raise Failed('%s did not read back the same' % p['name'])
            log.record('copied p%d %s, %d bytes, sha256 %s' % (n, p['name'], length, hashlib.sha256(data).hexdigest()))
    say('  13 boot partitions copied and read back')


def ext4_header(spec):
    fields = {}
    for line in run('debugfs', '-R', 'stats -h', spec, quiet=True).splitlines():
        key, sep, value = line.partition(':')
        if sep:
            fields[key.strip()] = value.strip()
    return fields


def make_app_filesystem(node, source_app):
    """ext4 with the running APP's features and label, which U-Boot reads."""
    head = ext4_header(source_app)
    features = [f for f in head.get('Filesystem features', '').split() if f != 'needs_recovery']
    if 'extent' not in features:
        raise Failed('cannot read the running APP\'s ext4 features')
    label = head.get('Filesystem volume name', '')
    fs_uuid = str(uuid.uuid4())
    cmd = ['mkfs.ext4', '-q', '-F', '-U', fs_uuid, '-O', 'none,' + ','.join(features),
           '-E', 'nodiscard,root_owner=0:0']
    if label and label != '<none>':
        cmd += ['-L', label]
    run(*(cmd + [node]))
    got = ext4_header(node).get('Filesystem features', '').split()
    if sorted(got) != sorted(features):
        raise Failed('the new APP has features %s, not %s' % (' '.join(got), ' '.join(features)))
    say('  APP formatted: ext4 with the running APP\'s features (%s)' % ' '.join(sorted(features)))
    return fs_uuid


def cut_image(where, info, parts, layout, disk_guid):
    """APP's ext4 shrunk to its contents and IMAGE_ROOM, the file cut after it, and
    the GPT written again for the shorter file, with its backup copy at the new
    end. The first boot grows APP and its ext4 to the end of the card the image
    is written to. Returns the image's size."""
    if run('losetup', '--associated', where).strip():
        raise Failed('the image is still attached to a loop device (a lazy unmount?)')
    m = Mounts()
    try:
        node = m.loop(where, layout[1]['start'] * SECTOR, layout[1]['size'] * SECTOR)
        run('e2fsck', '-f', '-y', node, ok=(0, 1))
        block = int(ext4_header(node).get('Block size', 0))
        minimum = re.search(r'minimum size of the filesystem: (\d+)', run('resize2fs', '-P', node))
        if not block or not minimum:
            raise Failed('cannot read APP\'s block size or its minimum size')
        mib = -(-(int(minimum.group(1)) * block + IMAGE_ROOM) // 2 ** 20)
        run('resize2fs', node, '%dM' % mib)
        run('e2fsck', '-f', '-n', node)
    finally:
        m.release()
    sectors = mib * 2 ** 20 // SECTOR
    total = (layout[1]['start'] + sectors + 34) * SECTOR      # the backup GPT after APP
    with open(where, 'r+b') as f:
        f.truncate(total)
    cut = target_layout(parts, total)
    cut[1]['uuid'] = layout[1]['uuid']
    if cut[1]['size'] != sectors:
        raise Failed('the cut APP would be %d sectors, not %d' % (cut[1]['size'], sectors))
    write_table(where, info, cut, disk_guid)
    return total


def hand_over(where):
    """The image and its SHA-256 file, for the account that ran sudo and only it: the
    image holds the password hashes, SSH keys and network profiles copied into it."""
    digest = sha256_file(where)
    with open(where + '.sha256', 'w') as f:
        f.write('%s  %s\n' % (digest, os.path.basename(where)))
    for p in (where, where + '.sha256'):
        os.chmod(p, 0o600)
        if os.environ.get('SUDO_UID', '').isdigit() and os.environ.get('SUDO_GID', '').isdigit():
            os.chown(p, int(os.environ['SUDO_UID']), int(os.environ['SUDO_GID']))
    log.record('image sha256 %s' % digest)
    return digest


def wait_for(node, seconds=20):
    for _ in range(seconds * 4):
        if os.path.exists(node):
            return node
        time.sleep(0.25)
    raise Failed('%s did not appear' % node)


def download(url, dest, sha256):
    """Fetch url to dest over HTTPS and check its SHA-256."""
    tmp = dest + '.part'
    h = hashlib.sha256()
    req = urllib.request.Request(url, headers={'User-Agent': 'nano26-convert'})
    with urllib.request.urlopen(req, timeout=60, context=ssl.create_default_context()) as r, open(tmp, 'wb') as f:
        for block in iter(lambda: r.read(1 << 20), b''):
            h.update(block)
            f.write(block)
    if h.hexdigest() != sha256:
        os.unlink(tmp)
        raise Failed('%s does not match its pinned SHA-256' % url)
    os.rename(tmp, dest)
    log.record('downloaded %s, sha256 %s' % (url, h.hexdigest()))


