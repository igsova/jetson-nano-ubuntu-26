SSHD_IPQOS = '# nano26-convert: no DSCP EF marking (docs/CONVERTER.md)\nIPQoS none\n'


def prepare_stage2(app):
    """nano26-stage2, its unit, and the repository files it runs, with their
    SHA-256 in /usr/lib/nano26/repo/SHA256SUMS, which stage 2 checks. zram swap
    is set up here, so the first boot with systemd has it for stage 2's builds."""
    script, unit = stage2_files()
    copy_file(script, os.path.join(app, STAGE2.lstrip('/')), 0o755)
    copy_file(unit, os.path.join(app, 'etc/systemd/system', STAGE2_UNIT), 0o644)
    repo = os.path.join(app, 'usr/lib/nano26/repo')
    sums = []
    for rel in REPO_FILES:
        src = os.path.join(REPO, rel)
        copy_file(src, os.path.join(repo, rel), 0o755 if os.stat(src).st_mode & 0o111 else 0o644)
        sums.append('%s  %s\n' % (sha256_file(src), rel))
    write_file(os.path.join(repo, 'SHA256SUMS'), ''.join(sums))
    write_file(os.path.join(app, 'etc/systemd/zram-generator.conf'), ZRAM)
    say('  stage 2 with %d repository files, for the first boot with systemd' % len(REPO_FILES))


def copy_identity(app, args):
    """Host keys, hostname and network profiles in place; accounts, zone and locale staged."""
    keys = host_keys() if args.copy_ssh_host_keys else []
    for name in keys:          # openssh-server's install keeps keys that are already there
        copy_file(path('/etc/ssh/' + name), os.path.join(app, 'etc/ssh', name), 0o600)
        copy_file(path('/etc/ssh/' + name + '.pub'), os.path.join(app, 'etc/ssh', name + '.pub'), 0o644)
    write_file(os.path.join(app, 'etc/ssh/sshd_config.d/50-nano26-ipqos.conf'), SSHD_IPQOS)
    hostname = (read_text('/etc/hostname', '') or '').strip()
    if not args.copy_hostname or not re.match(r'^[A-Za-z0-9][A-Za-z0-9-]{0,62}$', hostname):
        hostname = 'jetson-nano'
    write_file(os.path.join(app, 'etc/hostname'), hostname + '\n')
    write_file(os.path.join(app, 'etc/hosts'),
               '127.0.0.1 localhost\n127.0.1.1 %s\n::1 localhost ip6-localhost ip6-loopback\n' % hostname)
    profiles = network_profiles() if args.copy_network else []
    for name in profiles:
        base = name[:-len('.nmconnection')] if name.endswith('.nmconnection') else name
        copy_file(path('/etc/NetworkManager/system-connections/' + name),
                  os.path.join(app, 'etc/NetworkManager/system-connections', base + '.nmconnection'), 0o600)
    # Every device managed, as on JetPack 4 (Ubuntu's default leaves wired ones out).
    write_file(os.path.join(app, 'etc/NetworkManager/conf.d/10-globally-managed-devices.conf'), '')
    say('  hostname %s, %d SSH host key%s, %d network profile%s' % (
        hostname, len(keys), '' if len(keys) == 1 else 's', len(profiles), '' if len(profiles) == 1 else 's'))

    # The accounts, for the first boot, which creates them once Ubuntu's groups exist.
    staged = os.path.join(app, STATE, 'identity')
    os.makedirs(os.path.join(staged, 'keys'))
    os.chmod(staged, 0o700)
    shadow = {}
    for line in (read_text('/etc/shadow', '') or '').splitlines():
        f = line.split(':')
        if len(f) > 1:
            shadow[f[0]] = f[1]
    group_names, members = {}, {}
    for line in (read_text('/etc/group', '') or '').splitlines():
        f = line.split(':')
        if len(f) == 4:
            group_names[f[2]] = f[0]
            for user in filter(None, f[3].split(',')):
                members.setdefault(user, set()).add(f[0])
    rows, hashes = [], []
    for a in accounts():
        if not re.match(r'^[a-z_][a-z0-9_-]*$', a['name']) or not a['home'].startswith('/'):
            raise Failed('account %r cannot be copied' % a['name'])
        groups = sorted(members.get(a['name'], set()) | STANDARD_GROUPS)
        rows.append(':'.join([a['name'], str(a['uid']), str(a['gid']), group_names.get(str(a['gid']), a['name']),
                              a['gecos'], a['home'], ','.join(groups)]))
        hashed = shadow.get(a['name'], '').startswith('$')
        if hashed:
            hashes.append('%s:%s' % (a['name'], shadow[a['name']]))
        keys_file = path(a['home'] + '/.ssh/authorized_keys')
        if os.path.isfile(keys_file):
            copy_file(keys_file, os.path.join(staged, 'keys', a['name']), 0o600)
        say('  account %s (uid %d)%s' % (a['name'], a['uid'], '' if hashed else ', no password: SSH keys only'))
    write_file(os.path.join(staged, 'accounts'), ''.join(r + '\n' for r in rows), 0o600)
    write_file(os.path.join(staged, 'shadow'), ''.join(h + '\n' for h in hashes), 0o600)
    settings = ['zone=' + (time_zone() or 'Etc/UTC')] + ['locale=%s=%s' % kv for kv in locale_settings()]
    settings.append('owner=' + owner_account(accounts()))
    settings.append('card-min=%d' % MIN_TARGET)
    write_file(os.path.join(app, STATE, 'settings'), ''.join(s + '\n' for s in settings))


def stage1(source, target, args):
    info, parts = source
    layout = target_layout(parts, target['bytes'])
    disk_guid = str(uuid.uuid4())
    layout[1]['uuid'] = str(uuid.uuid4())
    source_disk = args.source_disk or '/dev/' + SOURCE_DISK
    source_app = ('%s?offset=%d' % (source_disk, parts[1]['start'] * SECTOR)) if args.source_disk \
        else '/dev/%sp1' % SOURCE_DISK
    m = Mounts()
    started = time.time()
    created = False
    steps = 7 if 'image' in target else 6
    fetched = None
    try:
        if not args.kernel:
            fetched = tempfile.mkdtemp(prefix='nano26-kernel-', dir='/var/tmp')
            args.kernel = fetch_kernel(fetched)
        say('STEP 1/%d the new card\'s partitions' % steps)
        if 'image' in target:
            where = target['image']
            fd = os.open(where, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)   # sparse until written
            created = True
            try:
                os.ftruncate(fd, target['bytes'])
            finally:
                os.close(fd)
        else:
            where = '/dev/' + target['name']
            again = [d for d in disks() if d['name'] == target['name']]
            if not again or again[0]['busy'] or again[0]['bytes'] != target['bytes'] \
                    or target_bytes(where) != target['bytes']:
                raise Failed('%s changed since the checks (its size, or it is now in use)' % where)
        write_table(where, info, layout, disk_guid)
        copy_boot_partitions(source_disk, where, parts)
        if 'image' in target:
            node = m.loop(where, layout[1]['start'] * SECTOR, layout[1]['size'] * SECTOR)
        else:
            run('blockdev', '--rereadpt', where)
            run('udevadm', 'settle', quiet=True)
            node = wait_for(where + '1')
            sysfs = '/sys/class/block/%s1/' % target['name']
            with open(sysfs + 'start') as s, open(sysfs + 'size') as z:
                if (int(s.read()), int(z.read())) != (layout[1]['start'], layout[1]['size']):
                    raise Failed('%s is not the new APP' % node)
        fs_uuid = make_app_filesystem(node, source_app)
        app = '/run/nano26-convert/app'
        os.makedirs(app, mode=0o700, exist_ok=True)
        m.mount('-t', 'ext4', '-o', 'noatime', node, app)

        say('STEP 2/%d Ubuntu 26.04 base' % steps)
        ubuntu_base(app)
        chroot_setup(app, m)

        say('STEP 3/%d Ubuntu\'s packages, downloaded for the first boot (this takes a while)' % steps)
        download_packages(app)

        say('STEP 4/%d NVIDIA\'s packages, downloaded for stage 2 (this takes a while)' % steps)
        nvidia_packages(app)

        say('STEP 5/%d the 5.10 kernel, the first boot and stage 2' % steps)
        install_kernel(app, args.kernel, layout[1]['uuid'])
        prepare_first_boot(app, fs_uuid)
        prepare_stage2(app)

        say('STEP 6/%d copied from this system' % steps)
        copy_identity(app, args)
        m.release()

        if 'image' in target:
            say('STEP 7/7 the image cut to its contents')
            size = cut_image(where, info, parts, layout, disk_guid)
            say('  image cut to %s; its first boot grows it to the card\'s end' % human(size))
            hand_over(where)
            say('  SHA-256 written to %s.sha256' % os.path.basename(where))
        run('sync')
        say('Written in %d min.' % ((time.time() - started) // 60))
        return True
    except (Failed, OSError, subprocess.SubprocessError, urllib.error.URLError, KeyboardInterrupt) as e:
        say('STOPPED: %s' % (str(e) or type(e).__name__))
        m.release()
        if created:
            for p in (where, where + '.sha256'):
                with contextlib.suppress(OSError):
                    os.unlink(p)
            say('  The unfinished image was deleted.')
        return False
    finally:
        m.release()
        if fetched:
            shutil.rmtree(fetched, ignore_errors=True)


def main():
    global ROOT
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    group = ap.add_mutually_exclusive_group(required=True)
    group.add_argument('--list', action='store_true', help='list the disks that could be the new card')
    group.add_argument('--target', help='the new card, a whole disk such as /dev/sda')
    group.add_argument('--target-image', help='write an image file instead of a card')
    ap.add_argument('--size', type=parse_size,
                    help='the space --target-image is built in, such as 12G (default: the free space, up to 16 GiB); '
                         'the image is cut to its contents at the end')
    ap.add_argument('--dry-run', action='store_true', help='check and print the plan only')
    ap.add_argument('--offline', action='store_true', help='skip the network check (dry run only)')
    ap.add_argument('--confirm', help='the target\'s name, instead of typing it at the prompt')
    ap.add_argument('--accept-nvidia-licences', action='store_true')
    ap.add_argument('--kernel', help='the 5.10 kernel: build-jp5-kernel.sh\'s out/ folder')
    ap.add_argument('--no-copy-ssh-host-keys', dest='copy_ssh_host_keys', action='store_false',
                    help='let the new card make its own SSH host keys')
    ap.add_argument('--no-copy-hostname', dest='copy_hostname', action='store_false',
                    help='name the new card jetson-nano')
    ap.add_argument('--no-copy-network', dest='copy_network', action='store_false',
                    help='leave out the saved network profiles (Wi-Fi passwords included)')
    ap.add_argument('--root', default='/', help=argparse.SUPPRESS)
    ap.add_argument('--source-disk', help=argparse.SUPPRESS)
    ap.add_argument('--skip-network-check', action='store_true', help=argparse.SUPPRESS)
    ap.add_argument('--nvidia-test-plan', help=argparse.SUPPRESS)
    args = ap.parse_args()
    ROOT = args.root
    if args.nvidia_test_plan:
        if args.root == '/':
            ap.error('--nvidia-test-plan is for tests with --root only')
        apply_test_plan(args.nvidia_test_plan)
    if args.offline and not args.dry_run:
        ap.error('--offline is for --dry-run only: the build needs the network')
    if args.kernel:
        args.kernel = os.path.abspath(args.kernel)

    if args.list:
        found = disks()
        for d in found:
            say(describe(d))
        if not found:
            say('No USB or removable disk found. Plug the new card in through a USB card reader.')
        return 0

    writing = not args.dry_run
    if writing and os.geteuid() == 0 and os.environ.get('NANO26_NS') != '1':
        # Everything mounted from here on lives in a private mount namespace
        # and disappears with it, whatever happens.
        os.environ['NANO26_NS'] = '1'
        os.execvp('unshare', ['unshare', '--mount', '--propagation', 'private', sys.executable,
                              os.path.abspath(sys.argv[0])] + sys.argv[1:])

    record = open_record()
    say('nano26-convert: JetPack 4.6.6 to Ubuntu 26.04 on the 5.10 kernel')
    c = Check()
    c.result('root', os.geteuid() == 0 or args.root != '/', 'uid %d' % os.geteuid())
    check_board(c)
    check_l4t(c)
    check_boot(c)
    source = check_source(c, args.source_disk or '/dev/' + SOURCE_DISK)
    if args.target:
        ok, target = check_target_device(c, args.target)
        if ok and writing and args.root != '/':
            c.result('target', False, 'a stand-in root (--root) only checks a device target; '
                                      'writing needs --target-image')
    else:
        _, target = check_target_image(c, args.target_image, args.size)
    if args.kernel:
        check_kernel(c, args.kernel)
    elif downloads_kernel(args):
        c.result('kernel', True, '%s, downloaded when writing (pinned SHA-256)' % KERNEL_BUNDLE_URL.rsplit('/', 1)[1])
    elif writing:
        c.result('kernel', False, 'give the 5.10 kernel with --kernel DIR (the kernel release is not published yet)')
    else:
        say('CHECK kernel   SKIP  dry run without --kernel')
    check_helpers(c)
    check_stage2_inputs(c)
    n = len(accounts())
    c.result('accounts', n > 0, '%d account%s with a login shell' % (n, '' if n == 1 else 's')
             + ('' if n else '; the new card would have no login'))
    check_clock(c)
    if args.offline or args.skip_network_check:
        say('CHECK network  SKIP  %s' % ('--offline' if args.offline else 'test run'))
    else:
        check_network(c)
    if source and target and target['bytes'] and source[1][1]['start'] * SECTOR >= target['bytes']:
        c.result('fit', False, 'the target is smaller than the boot partitions')
    say('NANO26_CHECKS=%s%s' % ('FAIL ' if c.failed else 'PASS', ' '.join(c.failed)))

    status = 1
    if not c.failed:
        print_plan(source, target, args)
        if args.dry_run:
            say('NANO26_DRY_RUN=DONE')
            status = 0
        elif not accept_licences(args):
            say('Stopped: NVIDIA\'s terms were not accepted. Nothing was written.')
        elif not confirm(target, args):
            say('Stopped: the name did not match. Nothing was written.')
        elif stage1(source, target, args):
            say()
            if target.get('image'):
                image = target['image']
                say('The image is ready: %s, %s, with its SHA-256 in %s.sha256.'
                    % (image, human(os.path.getsize(image)), os.path.basename(image)))
                say('It holds this system\'s password hashes, SSH keys and Wi-Fi passwords: keep it to')
                say('yourself. Next (docs/CONVERTER.md, What the user does):')
                say('  1. On your computer, copy both files from this Nano, where ADDRESS is its')
                say('     address (hostname -I shows it here):')
                say("       scp '%s@ADDRESS:%s*' ." % (os.environ.get('SUDO_USER') or 'USER', image))
                say('  2. Shut this Nano down (sudo poweroff), put this card in the computer\'s card')
                say('     reader and write %s to the whole card with balenaEtcher (or dd).'
                    % os.path.basename(image))
                say('     That replaces JetPack 4 on it.')
                say('  3. Put the card back in the Nano and power on. Its first boot grows Ubuntu 26.04')
                say('     to the whole card and installs its packages,')
            else:
                say('The new card is ready. Shut down (sudo poweroff), move it from the reader to the')
                say('Nano\'s card slot and power on. Its first boot installs Ubuntu 26.04\'s packages,')
            say('shown on the HDMI screen, and restarts by itself. The next boot builds and checks')
            say('the GPU stack (stage 2; a text login and SSH work meanwhile, as before) and')
            say('restarts into the desktop\'s login screen; /var/log/nano26/report.txt says what')
            if target.get('image'):
                say('passed. Until step 2 this card is unchanged, apart from the image file.')
            else:
                say('passed. Putting this card back in the slot is the way back.')
            say('NANO26_CONVERT=DONE')
            status = 0
        else:
            if target.get('image'):
                say('No image was made; the running card is unchanged. Run again to start over.')
            else:
                say('The new card is not usable; the running card is unchanged. Run again to start over.')
            say('NANO26_CONVERT=FAIL')
    if record:
        print('Record: ' + record)
    return status


if __name__ == '__main__':
    sys.exit(main())
