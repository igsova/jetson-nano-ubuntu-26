class Mounts:
    """Mounts and loop devices, released in reverse order."""
    def __init__(self):
        self.stack = []

    def mount(self, *args):
        run('mount', *args)
        self.stack.append(args[-1])

    def loop(self, image, offset, size):
        dev = run('losetup', '--find', '--show', '--offset', str(offset), '--sizelimit', str(size), image).strip()
        self.stack.append(('loop', dev))
        return dev

    def release(self):
        while self.stack:
            top = self.stack.pop()
            if isinstance(top, tuple):
                subprocess.run(['losetup', '--detach', top[1]])
            elif subprocess.run(['umount', '--recursive', top]).returncode != 0:
                subprocess.run(['umount', '--recursive', '--lazy', top])
                say('  (%s needed a lazy unmount)' % top)


def chroot_setup(app, m):
    m.mount('-t', 'proc', 'proc', os.path.join(app, 'proc'))
    m.mount('--bind', '/sys', os.path.join(app, 'sys'))
    run('mount', '-o', 'remount,bind,ro', os.path.join(app, 'sys'))
    m.mount('--rbind', '/dev', os.path.join(app, 'dev'))
    run('mount', '--make-rslave', os.path.join(app, 'dev'))
    m.mount('-t', 'tmpfs', '-o', 'nosuid,nodev,mode=0755,size=64m', 'tmpfs', os.path.join(app, 'run'))
    # resolved's stub path, filled from this system for the downloads; it is
    # the link the installed systemd-resolved keeps.
    stub = os.path.join(app, 'run/systemd/resolve')
    os.makedirs(stub)
    with open('/etc/resolv.conf', 'rb') as s, open(os.path.join(stub, 'stub-resolv.conf'), 'wb') as d:
        d.write(s.read())
    resolv = os.path.join(app, 'etc/resolv.conf')
    if os.path.lexists(resolv):
        os.unlink(resolv)
    os.symlink('../run/systemd/resolve/stub-resolv.conf', resolv)
    write_file(os.path.join(app, 'etc/apt/sources.list.d/ubuntu.sources'), APT_SOURCES)
    if os.path.lexists(os.path.join(app, 'etc/apt/sources.list')):
        os.unlink(os.path.join(app, 'etc/apt/sources.list'))


