def bash_array(rel, name):
    """The words of NAME=( ... ) in the repository's bash script REL."""
    with open(os.path.join(REPO, rel)) as f:
        found = re.search(r'^%s=\(([^)]*)\)' % name, f.read(), re.M)
    if not found:
        raise ValueError('no %s=(...) in %s' % (name, rel))
    return re.sub(r'#[^\n]*', '', found.group(1)).split()


INSTALL_PINS = None  # --nvidia-test-plan's stand-ins for install_pins()


def install_pins():
    """install-u26-r35.sh's pinned NVIDIA packages, {file name: SHA-256}; its
    nano-l4t entries are the owner's builds, which stage 2 makes anew."""
    if INSTALL_PINS is not None:
        return dict(INSTALL_PINS)
    with open(os.path.join(REPO, 'scripts/jetson/install-u26-r35.sh')) as f:
        pins = re.findall(r'^\s*\[([A-Za-z0-9.+~_-]+\.deb)\]=([0-9a-f]{64})\s*$', f.read(), re.M)
    return {name: digest for name, digest in pins if not name.startswith('nano-l4t-')}


_stage2_packages = []


def stage2_packages():
    """Ubuntu's packages for stage 2: the reference card's lists, STAGE2_TOOLS and what the
    nano-l4t packages depend on (the first of each set of alternatives)."""
    if _stage2_packages:
        return list(_stage2_packages)
    names = []
    for rel, var in REFERENCE_LISTS:
        names += bash_array(rel, var)
    names += STAGE2_TOOLS
    m = l4t()
    for line in [s['depends'] for s in m.R35_PACKAGES.values()] + [v['depends'] for v in m.VIDEOS.values()]:
        for group in line.split(','):
