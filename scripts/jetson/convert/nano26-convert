def check_network(c):
    ctx = ssl.create_default_context()
    bad = []
    for label, url in HOSTS:
        try:
            req = urllib.request.Request(url, method='HEAD', headers={'User-Agent': 'nano26-convert'})
            urllib.request.urlopen(req, timeout=20, context=ctx).close()
        except urllib.error.HTTPError:
            pass                      # the host answered; an error page still proves the route
        except (OSError, socket.timeout) as e:
            bad.append('%s (%s)' % (label, getattr(e, 'reason', e)))
    return c.result('network', not bad, 'all %d hosts answer' % len(HOSTS) if not bad else 'no answer from ' + ', '.join(bad))


