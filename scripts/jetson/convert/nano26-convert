# Where downloads come from: the servers, unless --nvidia-test-plan names stand-ins.
SOURCES = {}


def source_url(url):
    for real, stand_in in SOURCES.items():
        if url.startswith(real):
            return stand_in + url[len(real):]
    return url


def mirror_file(mirror, url):
    """URL's place in the copy of the repositories, laid out as the servers are."""
    return os.path.join(mirror, url.split('://', 1)[1])


def mirror_copy(src, dst):
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copyfile(src, dst)
    os.chmod(dst, 0o644)


@contextlib.contextmanager
def recorded_output():
    """What the repository's modules print goes to the record; their fail() stops the step."""
    buf = io.StringIO()
    try:
        with contextlib.redirect_stdout(buf):
            yield
    except SystemExit as e:
        raise Failed(str(e))
    finally:
        for line in buf.getvalue().splitlines():
            log.record('  ' + line)


def nvidia_packages(app):
    """NVIDIA's packages for stage 2, and Ubuntu 20.04's X server, in a copy of
    the repositories under MIRROR: the signed indexes, checked by
    fetch-r35-cuda.py's and fetch-cuda12-probe.py's code, then each package
    against its index entry and, where the repository pins one, its SHA-256.
    Lists of what each stage 2 step takes go to MIRROR/sets."""
    m, l = cuda12(), l4t()
    fetch, probe = m.fetch, m.probe
    fetch.BASE, probe.CUDA_REPO = source_url(JETSON_URL), source_url(CUDA_URL)
    mirror = os.path.join(app, MIRROR)
    work = os.path.join(app, STATE, 'nvidia-work')
    os.makedirs(work, mode=0o700)
    key = os.path.join(mirror, 'keys', 'jetson-ota-public.asc')
    mirror_copy(path(JETSON_KEY), key)
    indexes = {}
    with recorded_output():
        gnupg, keyring = fetch.prepare_keyring(Path(work), Path(key))
        for suite, release in JETSON_INDEXES:
            fetch.RELEASE = release
            run_dir = Path(work) / ('%s-%s' % (suite, release))
            run_dir.mkdir()
            url, entries, _ = fetch.fetch_index(run_dir, gnupg, keyring, suite)
            folder = str(run_dir / 'index' / suite)
            for name in os.listdir(folder):
                if name != 'gpgv-status.txt':
                    rel = 'dists/%s/%s%s' % (release, '' if name.startswith('Release') else 'main/binary-arm64/', name)
                    mirror_copy(os.path.join(folder, name), mirror_file(mirror, JETSON_URL + suite + '/' + rel))
            indexes[(suite, release)] = (url, entries)
        run_dir = Path(work) / 'cuda'
        run_dir.mkdir()
        cuda_gnupg, cuda_keyring = probe.cuda_keyring(run_dir)
        cuda_entries = probe.flat_index(run_dir, cuda_gnupg, cuda_keyring)
        mirror_copy(str(run_dir / probe.CUDA_KEY_FILE), mirror_file(mirror, CUDA_URL + probe.CUDA_KEY_FILE))
        for name in os.listdir(str(run_dir / 'index' / 'cuda')):
            if name != 'gpgv-status.txt':
                mirror_copy(str(run_dir / 'index' / 'cuda' / name), mirror_file(mirror, CUDA_URL + name))
    say('  NVIDIA\'s signed indexes checked: Jetson %s, and the CUDA repository'
        % ', '.join('%s %s' % i for i in JETSON_INDEXES))

    wanted = []  # (set, URL as the servers name it, size or None, SHA-256)

    def take(set_name, suite, release, name, version=None, digest=None):
        url, entries = indexes[(suite, release)]
        if version is None:
            found = [fetch.newest(entries, name, suite)] if name in entries else []
        else:
            found = [e for e in entries.get(name, []) if e['Version'] == version
                     and (digest is None or e['SHA256'] == digest)]
        if not found:
            raise Failed('%s %s is not in NVIDIA\'s %s %s index%s' % (
                name, version or '', suite, release, ' with the SHA-256 this repository pins' if digest else ''))
        e = found[0]
        wanted.append((set_name, JETSON_URL + suite + '/' + e['Filename'], int(e['Size']), e['SHA256']))

    # build-nano-l4t-debs.py's sources, as it pins them.
    for name, digest in sorted(l.NVIDIA_DEBS.items()) + sorted(l.VIDEO_NVIDIA_DEBS.items()):
        take('l4t', 't210', 'r32.7', name, l.L4T, digest)
    for name, digest in sorted(l.R35_NVIDIA_DEBS.items()) + sorted(l.R35_VIDEO_DEBS.items()):
        take('l4t', 't194', 'r35.6', name, l.R35_L4T, digest)
    for name, (version, digest) in sorted(l.UBUNTU_DEBS.items()):
        wanted.append(('l4t', PORTS + FOCAL_POOL[name] + '%s_%s_arm64.deb' % (name, version.split(':', 1)[-1]),
                       None, digest))
    # install-u26-r35.sh's: CUDA 11.4's runtime libraries, cuDNN 8.6 and TensorRT 8.5.
    for filename, digest in sorted(install_pins().items()):
        name, version, _ = filename[:-len('.deb')].split('_')
        take('install', 'common', 'r35.6', name, version, digest)
    # package-trt82.sh's: TensorRT 8.2 and what it depends on in the index, as
    # fetch-r35-cuda.py --set tensorrt --release r32.7 takes them.
    entries = indexes[('common', 'r32.7')][1]
    fetch.RELEASE = 'r32.7'
    absent = [n for n in fetch.TENSORRT_PACKAGES_R32 if n not in entries]
    if absent:
        raise Failed('not in NVIDIA\'s common r32.7 index: %s' % ', '.join(absent))
    queue, trt82 = list(fetch.TENSORRT_PACKAGES_R32), []
    while queue:
        name = queue.pop(0)
        if name in trt82 or name not in entries:
            continue
        trt82.append(name)
        queue += [d for d in fetch.dependency_names(fetch.newest(entries, name, 'common'))
                  if not d.endswith('-dev') and 'config-common' not in d]
    for name in trt82:
        take('trt82', 'common', 'r32.7', name)
    # build-nano-cuda12-debs.py's, by its own choice.
    url, entries = indexes[('common', m.R36_RELEASE)]
    fetch.RELEASE = m.R36_RELEASE
    with recorded_output():
        minor, cudart, plan, _, _ = m.choose(url, entries, cuda_entries)
    for name, base, entry, _ in plan:
        server = CUDA_URL if base == probe.CUDA_REPO else JETSON_URL + 'common/'
        wanted.append(('cuda12', server + entry['Filename'], int(entry['Size']), entry['SHA256']))

    sets, done = {}, {}
    total = sum(size for _, _, size, _ in wanted if size)
    say('  downloading %d packages (about %s): the driver sets, CUDA 11.4 with cuDNN 8.6 and TensorRT 8.5, '
        'TensorRT 8.2, and CUDA 12.%d (cuda-cudart-12-%d %s)' % (len(wanted), human(total), minor, minor,
                                                                    cudart['Version']))
    for set_name, url, size, digest in wanted:
        dest = mirror_file(mirror, url)
        if dest not in done:
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            download(source_url(url), dest, digest)
            if size is not None and os.path.getsize(dest) != size:
                raise Failed('%s is not the size its index gives' % url)
            done[dest] = digest
        sets.setdefault(set_name, []).append('%s  %s\n' % (digest, os.path.relpath(dest, mirror)))
    for set_name, lines in sets.items():
        write_file(os.path.join(mirror, 'sets', set_name + '.txt'), ''.join(lines))
    shutil.rmtree(work)
    say('  %s: %s' % (MIRROR, ', '.join('%s %d' % (s, len(v)) for s, v in sorted(sets.items()))))


