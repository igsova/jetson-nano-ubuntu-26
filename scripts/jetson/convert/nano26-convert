def target_layout(parts, total_bytes):
    total = total_bytes // SECTOR
    last_usable = total - 34                          # backup entries (32 sectors) and header
    app = parts[1]
    end = last_usable - (last_usable + 1 - app['start']) % 2048   # APP's size a whole MiB
    layout = {n: dict(p) for n, p in parts.items() if n != 1}
    layout[1] = dict(app, size=end - app['start'] + 1, uuid='(new)')
    return layout


