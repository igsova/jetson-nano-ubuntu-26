# --- GPT (UEFI spec 2.x, chapter 5): header at LBA 1, entries after it ---

HEADER = struct.Struct('<8sIIIIQQQQ16sQIII')
ENTRY = struct.Struct('<16s16sQQQ72s')


def read_gpt(f):
    f.seek(SECTOR)
    raw = f.read(HEADER.size)
    (sig, rev, hsize, hcrc, _, current, backup, first, last, disk_guid,
     entries_lba, count, esize, ecrc) = HEADER.unpack(raw)
    if sig != b'EFI PART':
        raise ValueError('no GPT header at sector 1')
    f.seek(SECTOR)
    head = bytearray(f.read(hsize))
    head[16:20] = b'\0\0\0\0'
    if zlib.crc32(bytes(head)) & 0xffffffff != hcrc:
        raise ValueError('GPT header checksum mismatch')
    f.seek(entries_lba * SECTOR)
    table = f.read(count * esize)
    if zlib.crc32(table) & 0xffffffff != ecrc:
        raise ValueError('GPT entries checksum mismatch')
    parts = {}
    for i in range(count):
        tguid, pguid, start, end, attrs, name = ENTRY.unpack(table[i * esize:i * esize + ENTRY.size])
        if tguid == b'\0' * 16:
            continue
        parts[i + 1] = {
            'type': str(uuid.UUID(bytes_le=tguid)), 'uuid': str(uuid.UUID(bytes_le=pguid)),
            'start': start, 'size': end - start + 1, 'attrs': attrs,
            'name': name.decode('utf-16-le').split('\0', 1)[0],
        }
    return {'disk_guid': str(uuid.UUID(bytes_le=disk_guid)), 'first': first, 'last': last,
            'backup': backup, 'entries': count}, parts


