def key_fingerprints(key):
    """The fingerprints in an OpenPGP key file, primary first (gpg in a throwaway home)."""
    home = tempfile.mkdtemp(prefix='nano26-gpg-')
    try:
        shown = subprocess.run(['gpg', '--homedir', home, '--batch', '--with-colons', '--import-options',
                                'show-only', '--import', key], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               universal_newlines=True)
    finally:
        shutil.rmtree(home, ignore_errors=True)
    return [line.split(':')[9] for line in shown.stdout.splitlines() if line.startswith('fpr:')]


def check_stage2_inputs(c):
    """The repository's files for stage 2, the reference card's package lists, and NVIDIA's key."""
    problems = []
    for name in stage2_files():
        if not os.path.isfile(name):
            problems.append('%s is not beside this script' % os.path.basename(name))
    missing = [rel for rel in REPO_FILES if not os.path.isfile(os.path.join(REPO, rel))]
    if missing:
        problems.append('not in this copy of the repository: %s' % ', '.join(missing[:3]))
    try:
        pins = install_pins()
        packages = stage2_packages()
        cuda12()
        if len(pins) != 19:
            problems.append('install-u26-r35.sh pins %d NVIDIA packages, not 19' % len(pins))
    except (OSError, ValueError, ImportError, SyntaxError, AttributeError, KeyError) as e:
        problems.append('cannot read the repository\'s scripts (%s)' % e)
        packages = []
    c.result('stage2', not problems, '%d repository files, %d Ubuntu packages for the GPU stack and desktops'
             % (len(REPO_FILES), len(packages)) + ('; ' + '; '.join(problems) if problems else ''))
    tools = [t for t in ('gpg', 'gpgv') if not shutil.which(t)]
    key = path(JETSON_KEY)
    if tools:
        return c.result('nvidia-key', False, 'no %s (gnupg)' % ' or '.join(tools))
    if not os.path.isfile(key):
        return c.result('nvidia-key', False, 'no %s (NVIDIA\'s apt key, which JetPack 4 installs)' % JETSON_KEY)
    try:
        want = cuda12().fetch.KEY_FINGERPRINT
    except Exception:  # reported by the stage2 check above
        return c.result('nvidia-key', False, 'the repository\'s fetch-r35-cuda.py did not load')
    got = key_fingerprints(key)
    return c.result('nvidia-key', bool(got) and got[0] == want, '%s, primary key %s' % (
