def read_text(p, default=None):
    try:
        with open(path(p), 'rb') as f:
            return f.read().decode('utf-8', 'replace')
    except OSError:
        return default


def human(n):
    for unit in ('bytes', 'KiB', 'MiB', 'GiB', 'TiB'):
        if n < 1024 or unit == 'TiB':
            return ('%d %s' % (n, unit)) if unit == 'bytes' else ('%.1f %s' % (n, unit))
        n /= 1024.0


def parse_size(text):
    m = re.match(r'^(\d+)([KMGT]?)$', text.strip().upper())
    if not m:
        raise argparse.ArgumentTypeError('a size such as 64G or 64000000000')
    return int(m.group(1)) * 1000 ** ' KMGT'.index(m.group(2) or ' ')


class Log:
    """Lines for the screen and the record; record() lines go to the record only."""
    def __init__(self):
        self.lines = []
        self.file = None

    def say(self, line=''):
        print(line, flush=True)
        self.record(line)

    def record(self, text):
        self.lines.append(text)
        if self.file:
            self.file.write(text + '\n')
            self.file.flush()

    def open(self, folder):
        self.file = open(os.path.join(folder, 'log.txt'), 'w')
        self.file.write(''.join(line + '\n' for line in self.lines))
        self.file.flush()


