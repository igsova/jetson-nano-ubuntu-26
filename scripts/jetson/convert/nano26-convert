_modules = {}


def repo_module(rel):
    """One of this repository's Python scripts, loaded as a module (once)."""
    if rel not in _modules:
        spec = importlib.util.spec_from_file_location(re.sub(r'\W', '_', os.path.basename(rel)),
                                                      os.path.join(REPO, rel))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        _modules[rel] = module
    return _modules[rel]


def cuda12():
