def dpkg_version(package):
    status = read_text('/var/lib/dpkg/status', '')
    for para in status.split('\n\n'):
        fields = dict(re.findall(r'(?m)^([A-Za-z-]+): (.*)$', para))
        if fields.get('Package') == package and fields.get('Status', '').endswith(' installed'):
            return fields.get('Version')
    return None


def check_l4t(c):
    line = (read_text('/etc/nv_tegra_release', '') or '').splitlines()[:1]
    m = re.match(r'# R(\d+) \(release\), REVISION: ([\d.]+)', line[0]) if line else None
    release = (m.group(1), m.group(2)) if m else None
    boot = dpkg_version(BOOTLOADER_PACKAGE)
    ok = release == L4T_RELEASE and bool(boot) and boot.startswith('.'.join(L4T_RELEASE) + '-')
    detail = 'L4T %s, %s %s' % ('R%s.%s' % release if release else 'unknown', BOOTLOADER_PACKAGE, boot or 'not installed')
    if not ok:
        detail += '; update to JetPack 4.6.6 (L4T R32.7.6) with NVIDIA\'s apt update first'
    return c.result('l4t', ok, detail)


def check_boot(c):
    root_dev = None
    for line in (read_text('/proc/self/mountinfo', '') or '').splitlines():
        fields = line.split()
        if len(fields) > 4 and fields[4] == '/':
            root_dev = fields[2]
    app_dev = (read_text('/sys/class/block/%sp1/dev' % SOURCE_DISK, '') or '').strip()
    ok = bool(root_dev) and root_dev == app_dev
    return c.result('boot', ok, 'root on %s, %sp1 is %s' % (root_dev or 'unknown', SOURCE_DISK, app_dev or 'missing'))


def check_source(c, source_disk):
    try:
        with open(source_disk, 'rb') as f:
            info, parts = read_gpt(f)
    except (OSError, ValueError) as e:
        c.result('source', False, '%s: %s' % (source_disk, e))
        return None
    app = parts.get(1)
    boot = {n: p for n, p in parts.items() if n != 1}
    problems = []
    if sorted(parts) != list(range(1, 15)):
        problems.append('partitions %s, expected 1 to 14' % sorted(parts))
    if not app or app['name'] != 'APP':
        problems.append('partition 1 is not APP')
    elif any(p['start'] + p['size'] > app['start'] for p in boot.values()):
        problems.append('a boot partition lies after APP')
    order = sorted(boot, key=lambda n: boot[n]['start'])
    if order != sorted(boot):
        problems.append('boot partitions out of order: %s' % order)
    detail = '%d partitions, APP at sector %d' % (len(parts), app['start']) if app else '%d partitions' % len(parts)
    c.result('source', not problems, detail + ('; ' + '; '.join(problems) if problems else ''))
    return None if problems else (info, parts)


def mounted_devices():
    used = set()
    for name in ('/proc/mounts', '/proc/swaps'):
        for line in (read_text(name, '') or '').splitlines():
            dev = line.split()[0] if line.split() else ''
            if dev.startswith('/dev/'):
                used.add(os.path.basename(dev))
    return used


def disks():
    """Whole disks that could be the new card: USB or removable, not the boot card."""
    used = mounted_devices()
    out = []
    try:
        names = sorted(os.listdir(path('/sys/block')))
    except OSError:
        names = []
    for name in names:
        if re.match(r'^(loop|ram|zram|nbd|md|dm-|mtdblock|mmcblk)', name):
            continue
        base = '/sys/block/' + name
        real = os.path.realpath(path(base))
        usb = '/usb' in real
        removable = (read_text(base + '/removable', '0') or '0').strip() == '1'
        if not (usb or removable):
            continue
        sectors = int((read_text(base + '/size', '0') or '0').strip() or 0)
        logical = int((read_text(base + '/queue/logical_block_size', '512') or '512').strip() or 512)
        parts = [p for p in os.listdir(path(base)) if p.startswith(name)] if os.path.isdir(path(base)) else []
        holders = []
        for node in [base] + [base + '/' + p for p in parts]:
            try:
                holders += os.listdir(path(node + '/holders'))
            except OSError:
                pass
        busy = sorted(({name} | set(parts)) & used) + sorted(holders)
        model = ' '.join(filter(None, [(read_text(base + '/device/vendor', '') or '').strip(),
                                       (read_text(base + '/device/model', '') or '').strip()]))
        out.append({'name': name, 'bytes': sectors * 512, 'logical': logical, 'usb': usb,
                    'model': model or 'unknown model', 'partitions': len(parts), 'busy': busy})
    return out


def describe(d):
    return '/dev/%s  %s (%d bytes)  %s%s, %d partition%s%s' % (
        d['name'], human(d['bytes']), d['bytes'], d['model'], ' on USB' if d['usb'] else '',
        d['partitions'], '' if d['partitions'] == 1 else 's',
        ', IN USE: ' + ' '.join(d['busy']) if d['busy'] else '')


def check_target_device(c, target):
    name = os.path.basename(target)
    if name.startswith(SOURCE_DISK):
        return c.result('target', False, '%s is the card this system runs from' % target), None
    if not re.match(r'^/dev/[a-z]+$', target):
        return c.result('target', False, '%s: give a whole disk such as /dev/sda' % target), None
    found = [d for d in disks() if d['name'] == name]
    if not found:
        return c.result('target', False, '%s is not a USB or removable disk here (see --list)' % target), None
    d = found[0]
    problems = []
    if d['busy']:
        problems.append('in use: %s (unmount it first)' % ' '.join(d['busy']))
    if d['logical'] != SECTOR:
        problems.append('%d-byte sectors, need %d' % (d['logical'], SECTOR))
    if d['bytes'] < MIN_TARGET:
        problems.append('smaller than %s' % human(MIN_TARGET))
    c.result('target', not problems, describe(d) + ('; ' + '; '.join(problems) if problems else ''))
    return not problems, d


def free_bytes(folder):
    st = os.statvfs(folder)
    return st.f_bavail * st.f_frsize


def check_target_image(c, image, size):
    """A new image file. It is built in a sparse file of the working size (--size,
    else what the folder has free, up to IMAGE_WORK_MAX), which never takes more
    than that, and cut to its contents at the end."""
    problems = []
    folder = os.path.dirname(os.path.abspath(image))
    free = 0
    if os.path.lexists(image):
        problems.append('it already exists')
    if not os.path.isdir(folder):
        problems.append('its folder does not exist')
    else:
        free = max(free_bytes(folder) - IMAGE_RESERVE, 0)
        if size is None:
            size = min(free, IMAGE_WORK_MAX) >> 20 << 20
        if size < IMAGE_WORK_MIN:
            problems.append('it needs %s to be built in (estimate); %s free there, keeping %s for this system'
                            % (human(IMAGE_WORK_MIN), human(free), human(IMAGE_RESERVE)))
        elif size > free:
            problems.append('%s free there, keeping %s for this system, not %s'
                            % (human(free), human(IMAGE_RESERVE), human(size)))
    size = size or 0
    d = {'name': os.path.basename(image), 'bytes': size, 'logical': SECTOR, 'image': os.path.abspath(image)}
    c.result('target', not problems, 'image file %s, built in %s, then cut to its contents'
             % (image, human(size)) + ('; ' + '; '.join(problems) if problems else ''))
    return not problems, d


def sha256_file(p):
    h = hashlib.sha256()
    with open(p, 'rb') as f:
        for block in iter(lambda: f.read(1 << 20), b''):
            h.update(block)
    return h.hexdigest()


def downloads_kernel(args):
    """Whether the kernel is the published download, not a folder given with --kernel."""
    return not args.kernel and KERNEL_BUNDLE_SHA256 is not None


def fetch_kernel(folder):
    """The published kernel, checked against its pinned SHA-256 and unpacked in
    FOLDER, then checked as a folder given with --kernel is. Returns its folder."""
    name = KERNEL_BUNDLE_URL.rsplit('/', 1)[1]
    say('The 5.10 kernel: downloading %s' % name)
    bundle = os.path.join(folder, name)
    download(source_url(KERNEL_BUNDLE_URL), bundle, KERNEL_BUNDLE_SHA256)
    run('tar', '--extract', '--xz', '--file', bundle, '--directory', folder, '--no-same-owner')
    os.unlink(bundle)
    kernel = os.path.join(folder, 'nano26-kernel')
    c = Check()
    if not check_kernel(c, kernel):
        raise Failed('the downloaded kernel does not pass its check')
    return kernel


def check_kernel(c, folder):
    """build-jp5-kernel.sh's out/: every file in SHA256SUMS, the Image, DTB and modules."""
    sums = {}
    try:
        with open(os.path.join(folder, 'SHA256SUMS')) as f:
            for line in f:
                digest, name = line.rstrip('\n').split('  ', 1)
                sums[name] = digest
    except (OSError, ValueError) as e:
        return c.result('kernel', False, '%s: no readable SHA256SUMS (%s)' % (folder, e))
    present = set()
    for top, dirs, files in os.walk(folder):
        for name in files:
            rel = os.path.relpath(os.path.join(top, name), folder)
            if rel != 'SHA256SUMS':
                present.add(rel)
    problems = []
    if present != set(sums):
        problems.append('files and SHA256SUMS differ: %s' % ', '.join(sorted(present ^ set(sums))[:3]))
    for name, digest in sorted(sums.items()):
        if name in present and sha256_file(os.path.join(folder, name)) != digest:
            problems.append('%s does not match SHA256SUMS' % name)
    try:
        with open(os.path.join(folder, 'Image'), 'rb') as f:
            data = f.read()
        if data[56:60] != b'ARM\x64' or ('Linux version %s ' % KERNEL_RELEASE).encode() not in data:
            problems.append('Image is not a %s arm64 kernel' % KERNEL_RELEASE)
    except OSError:
        problems.append('no Image')
    try:
        with open(os.path.join(folder, 'dtb', DTB), 'rb') as f:
            data = f.read()
        if data[:4] != b'\xd0\x0d\xfe\xed' or COMPATIBLE.encode() not in data:
            problems.append('dtb/%s is not the Nano B01 device tree' % DTB)
    except OSError:
        problems.append('no dtb/%s' % DTB)
    dep = os.path.join(folder, 'modules/lib/modules', KERNEL_RELEASE, 'modules.dep')
    try:
        with open(dep) as f:
            if '/nvgpu.ko:' not in f.read():
                problems.append('modules.dep has no nvgpu')
    except OSError:
        problems.append('no modules for %s' % KERNEL_RELEASE)
    return c.result('kernel', not problems, '%s, %s, %d files' % (folder, KERNEL_RELEASE, len(sums))
                    + ('; ' + '; '.join(problems) if problems else ''))


