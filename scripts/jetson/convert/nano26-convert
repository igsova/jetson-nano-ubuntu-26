def accounts():
    """People's accounts: uid 1000 to 59999 with a login shell."""
    out = []
    for line in (read_text('/etc/passwd', '') or '').splitlines():
        f = line.split(':')
        if len(f) == 7 and f[2].isdigit() and f[3].isdigit() and 1000 <= int(f[2]) < 60000 \
                and not f[6].endswith(('nologin', 'false')):
            out.append({'name': f[0], 'uid': int(f[2]), 'gid': int(f[3]), 'gecos': f[4], 'home': f[5]})
    return out


def host_keys():
    try:
        names = sorted(os.listdir(path('/etc/ssh')))
    except OSError:
        return []
    return [k for k in names if re.match(r'^ssh_host_\w+_key$', k) and k + '.pub' in names]


def network_profiles():
    folder = path('/etc/NetworkManager/system-connections')
    try:
        return [n for n in sorted(os.listdir(folder)) if os.path.isfile(os.path.join(folder, n))]
    except OSError:
        return []


def time_zone():
    zone = (read_text('/etc/timezone', '') or '').strip()
    if not zone and os.path.islink(path('/etc/localtime')):
        zone = os.readlink(path('/etc/localtime')).split('zoneinfo/', 1)[-1]
    return zone if re.match(r'^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$', zone) else ''


def locale_settings():
    """LANG and LC_* from /etc/default/locale whose value is a UTF-8 locale localedef can build."""
    out = []
    for line in (read_text('/etc/default/locale', '') or '').splitlines():
        m = re.match(r'^(LANG|LC_[A-Z]+)="?([^"]*)"?$', line.strip())
        if not m:
            continue
        v = re.match(r'^([a-z]{2,3}_[A-Z]{2})\.(UTF-8|utf8)$', m.group(2))
        if v:
            out.append((m.group(1), v.group(1) + '.UTF-8'))
        elif m.group(2) in ('C.UTF-8', 'C.utf8'):
            out.append((m.group(1), 'C.UTF-8'))
    return out


def identity():
    users = []
    for a in accounts():
        keys = read_text(a['home'] + '/.ssh/authorized_keys', '') or ''
        users.append((a['name'], a['uid'], len([k for k in keys.splitlines() if k.strip() and not k.startswith('#')])))
    return {'users': users, 'hostname': (read_text('/etc/hostname', '') or '').strip(), 'zone': time_zone(),
            'lang': dict(locale_settings()).get('LANG', ''), 'profiles': len(network_profiles()),
            'hostkeys': len(host_keys())}


