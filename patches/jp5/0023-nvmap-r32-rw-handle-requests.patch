nvmap: serve R32's READ and WRITE handle requests

JetPack 4's video converter and camera daemon got ENOTTY from
NVMAP_IOC_WRITE ("Unknown NVMAP_IOC = 0x40204e06"). R32's nvmap takes three
layouts for WRITE and READ; R35 keeps two, and dropped the 32-byte one
JetPack 4's libraries use.

Add it back as struct nvmap_rw_handle_r32, read and answered as R32 does. A
build-time check keeps the struct at 32 bytes.

Found: trial 33. Tested on the Nano: no unknown nvmap request in trial 34;
in trial 36 the converter made 305 WRITE and 180 READ calls in R32's
layout, all answered.

Licence: GPL-2.0-only. Lab notes, with every measurement: NOTES.md.
---
diff --git a/nvidia/drivers/video/tegra/nvmap/nvmap_dev.c b/nvidia/drivers/video/tegra/nvmap/nvmap_dev.c
index fd49509aa..4ed79f979 100644
--- a/nvidia/drivers/video/tegra/nvmap/nvmap_dev.c
+++ b/nvidia/drivers/video/tegra/nvmap/nvmap_dev.c
@@ -425,6 +425,12 @@ static long nvmap_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
 			sizeof(struct nvmap_rw_handle));
 		break;
 
+	case NVMAP_IOC_WRITE_R32:
+	case NVMAP_IOC_READ_R32:
+		err = nvmap_ioctl_rw_handle(filp, cmd == NVMAP_IOC_READ_R32,
+			uarg, sizeof(struct nvmap_rw_handle_r32));
+		break;
+
 #ifdef CONFIG_COMPAT
 	case NVMAP_IOC_CACHE_32:
 		err = nvmap_ioctl_cache_maint(filp, uarg,
diff --git a/nvidia/drivers/video/tegra/nvmap/nvmap_ioctl.c b/nvidia/drivers/video/tegra/nvmap/nvmap_ioctl.c
index 7a5c75903..7900984a7 100644
--- a/nvidia/drivers/video/tegra/nvmap/nvmap_ioctl.c
+++ b/nvidia/drivers/video/tegra/nvmap/nvmap_ioctl.c
@@ -461,6 +461,8 @@ int nvmap_ioctl_rw_handle(struct file *filp, int is_read, void __user *arg,
 	struct nvmap_client *client = filp->private_data;
 	struct nvmap_rw_handle __user *uarg = arg;
 	struct nvmap_rw_handle op;
+	struct nvmap_rw_handle_r32 __user *uarg_r32 = arg;
+	struct nvmap_rw_handle_r32 op_r32;
 #ifdef CONFIG_COMPAT
 	struct nvmap_rw_handle_32 __user *uarg32 = arg;
 	struct nvmap_rw_handle_32 op32;
@@ -472,6 +474,10 @@ int nvmap_ioctl_rw_handle(struct file *filp, int is_read, void __user *arg,
 	unsigned long count;
 	int handle;
 
+	/* The three layouts are told apart by size: 28, 32 and 56 bytes. */
+	BUILD_BUG_ON(sizeof(op_r32) != 32);
+	BUILD_BUG_ON(sizeof(op_r32) == sizeof(op));
+
 #ifdef CONFIG_COMPAT
 	if (op_size == sizeof(op32)) {
 		if (copy_from_user(&op32, arg, sizeof(op32)))
@@ -485,7 +491,17 @@ int nvmap_ioctl_rw_handle(struct file *filp, int is_read, void __user *arg,
 		count = op32.count;
 	} else
 #endif
-	{
+	if (op_size == sizeof(op_r32)) {
+		if (copy_from_user(&op_r32, arg, sizeof(op_r32)))
+			return -EFAULT;
+		addr = op_r32.addr;
+		handle = op_r32.handle;
+		offset = op_r32.offset;
+		elem_size = op_r32.elem_size;
+		hmem_stride = op_r32.hmem_stride;
+		user_stride = op_r32.user_stride;
+		count = op_r32.count;
+	} else {
 		if (copy_from_user(&op, arg, sizeof(op)))
 			return -EFAULT;
 		addr = op.addr;
@@ -544,6 +560,9 @@ int nvmap_ioctl_rw_handle(struct file *filp, int is_read, void __user *arg,
 		__put_user(copied, &uarg32->count);
 	else
 #endif
+	if (op_size == sizeof(op_r32))
+		__put_user(copied, &uarg_r32->count);
+	else
 		__put_user(copied, &uarg->count);
 
 	nvmap_handle_put(h);
diff --git a/nvidia/include/uapi/linux/nvmap.h b/nvidia/include/uapi/linux/nvmap.h
index e2c6c9857..38c8eb264 100644
--- a/nvidia/include/uapi/linux/nvmap.h
+++ b/nvidia/include/uapi/linux/nvmap.h
@@ -285,6 +285,24 @@ struct nvmap_duplicate_handle {
 #define NVMAP_IOC_WRITE_32   _IOW(NVMAP_IOC_MAGIC, 6, struct nvmap_rw_handle_32)
 #define NVMAP_IOC_READ_32    _IOW(NVMAP_IOC_MAGIC, 7, struct nvmap_rw_handle_32)
 #endif /* CONFIG_COMPAT */
+
+/*
+ * R32's 64-bit NVMAP_IOC_WRITE and NVMAP_IOC_READ, with 32-bit offset,
+ * sizes and count, which JetPack 4's userspace still issues (0x40204e06 and
+ * 0x40204e07). R35 kept only R32's NVMAP_IOC_WRITE_64 and _READ_64 layout,
+ * under the plain names.
+ */
+struct nvmap_rw_handle_r32 {
+	__u64 addr;		/* user pointer */
+	__u32 handle;		/* nvmap handle */
+	__u32 offset;		/* offset into hmem */
+	__u32 elem_size;	/* individual atom size */
+	__u32 hmem_stride;	/* delta in bytes between atoms in hmem */
+	__u32 user_stride;	/* delta in bytes between atoms in user */
+	__u32 count;		/* number of atoms to copy */
+};
+#define NVMAP_IOC_WRITE_R32  _IOW(NVMAP_IOC_MAGIC, 6, struct nvmap_rw_handle_r32)
+#define NVMAP_IOC_READ_R32   _IOW(NVMAP_IOC_MAGIC, 7, struct nvmap_rw_handle_r32)
 #endif /* __KERNEL__ */
 
 #define NVMAP_IOC_PARAM _IOWR(NVMAP_IOC_MAGIC, 8, struct nvmap_handle_param)
