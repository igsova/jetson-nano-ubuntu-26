diff --git a/nvidia/nvgpu/drivers/gpu/nvgpu/hal/clk/clk_gm20b.c b/nvidia/nvgpu/drivers/gpu/nvgpu/hal/clk/clk_gm20b.c
index 34d3ae904..460abedc0 100644
--- a/nvidia/nvgpu/drivers/gpu/nvgpu/hal/clk/clk_gm20b.c
+++ b/nvidia/nvgpu/drivers/gpu/nvgpu/hal/clk/clk_gm20b.c
@@ -1301,7 +1301,9 @@ int gm20b_clk_prepare(struct clk_gk20a *clk)
 
 	nvgpu_mutex_acquire(&clk->clk_mutex);
 	if (!clk->gpc_pll.enabled && clk->clk_hw_on) {
+		nvgpu_info(clk->g, "clk: gpcclk prepare sets the PLL");
 		ret = set_pll_freq(clk->g, true);
+		nvgpu_info(clk->g, "clk: gpcclk prepare PLL %d", ret);
 	}
 	nvgpu_mutex_release(&clk->clk_mutex);
 	return ret;
@@ -1494,12 +1496,14 @@ int gm20b_init_clk_support(struct gk20a *g)
 
 	err = gm20b_init_clk_setup_hw(g);
 	nvgpu_mutex_release(&clk->clk_mutex);
+	nvgpu_info(g, "clk: hw setup %d", err);
 	if (err != 0) {
 		return err;
 	}
 
 	/* FIXME: this effectively prevents host level clock gating */
 	err = g->ops.clk.prepare_enable(&g->clk);
+	nvgpu_info(g, "clk: prepare_enable %d", err);
 	if (err != 0) {
 		return err;
 	}
@@ -1510,6 +1514,7 @@ int gm20b_init_clk_support(struct gk20a *g)
 		err = set_pll_freq(g, true);
 	}
 	nvgpu_mutex_release(&clk->clk_mutex);
+	nvgpu_info(g, "clk: PLL %d at %u kHz gpc2clk", err, clk->gpc_pll.freq);
 
 	return err;
 }
