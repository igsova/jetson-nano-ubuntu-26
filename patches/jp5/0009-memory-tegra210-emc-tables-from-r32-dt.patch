+
+struct tegra210_emc_dt_array {
+	const char *name;
+	size_t offset;
+	size_t count;	/* offset of the field holding the length */
+	u32 size;
+};
+
+#define EMC_DT_ARRAY(_name, _field, _count)				\
+	{ _name, offsetof(struct tegra210_emc_timing, _field),		\
+	  offsetof(struct tegra210_emc_timing, _count),		\
+	  sizeof_field(struct tegra210_emc_timing, _field) / sizeof(u32) }
+
+static const struct tegra210_emc_dt_array tegra210_emc_dt_arrays[] = {
+	EMC_DT_ARRAY("nvidia,emc-registers", burst_regs, num_burst),
+	EMC_DT_ARRAY("nvidia,emc-burst-regs-per-ch", burst_reg_per_ch, num_burst_per_ch),
+	EMC_DT_ARRAY("nvidia,emc-shadow-regs-ca-train", shadow_regs_ca_train, num_burst),
+	EMC_DT_ARRAY("nvidia,emc-shadow-regs-quse-train", shadow_regs_quse_train, num_burst),
+	EMC_DT_ARRAY("nvidia,emc-shadow-regs-rdwr-train", shadow_regs_rdwr_train, num_burst),
+	EMC_DT_ARRAY("nvidia,emc-trim-regs", trim_regs, num_trim),
+	EMC_DT_ARRAY("nvidia,emc-trim-regs-per-ch", trim_perch_regs, num_trim_per_ch),
+	EMC_DT_ARRAY("nvidia,emc-vref-regs", vref_perch_regs, vref_num),
+	EMC_DT_ARRAY("nvidia,emc-dram-timing-regs", dram_timings, dram_timing_num),
+	EMC_DT_ARRAY("nvidia,emc-burst-mc-regs", burst_mc_regs, num_mc_regs),
+	EMC_DT_ARRAY("nvidia,emc-la-scale-regs", la_scale_regs, num_up_down),
+};
+
+static int tegra210_emc_parse_dt_timing(struct device *dev,
+					struct device_node *np,
+					struct tegra210_emc_timing *timing)
+{
+	u8 *base = (u8 *)timing;
+	const char *name;
+	unsigned int i;
+	int err;
+
+	for (i = 0; i < ARRAY_SIZE(tegra210_emc_dt_u32s); i++) {
+		const struct tegra210_emc_dt_u32 *field = &tegra210_emc_dt_u32s[i];
+
+		if (timing->revision < field->min_revision)
+			continue;
+
+		name = field->name;
+		err = of_property_read_u32(np, name, (u32 *)(base + field->offset));
+		if (err < 0)
+			goto fail;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(tegra210_emc_dt_arrays); i++) {
+		const struct tegra210_emc_dt_array *array = &tegra210_emc_dt_arrays[i];
+		u32 count = *(u32 *)(base + array->count);
+
+		name = array->name;
+		if (count > array->size) {
+			err = -EOVERFLOW;
+			goto fail;
+		}
+
+		err = of_property_read_u32_array(np, name, (u32 *)(base + array->offset),
+						 count);
+		if (err < 0)
+			goto fail;
+	}
+
+	if (timing->revision >= 7) {
+		name = "nvidia,ptfv";
+		err = of_property_read_u32_array(np, name, timing->ptfv_list,
+						 ARRAY_SIZE(timing->ptfv_list));
+		if (err < 0)
+			goto fail;
+	}
+
+	return 0;
+
+fail:
+	dev_err(dev, "%pOF: cannot read %s: %d\n", np, name, err);
+	return err;
+}
+
+/* Parse the children compatible with @compatible; returns how many. */
+static int tegra210_emc_parse_dt_set(struct tegra210_emc *emc,
+				     struct device_node *np,
+				     const char *compatible,
+				     struct tegra210_emc_timing **timingsp)
+{
+	struct tegra210_emc_timing *timings;
+	struct device_node *child;
+	unsigned int count = 0, i = 0;
+	int err;
+
+	for_each_child_of_node(np, child)
+		if (of_device_is_compatible(child, compatible))
+			count++;
+
+	if (!count)
+		return 0;
+
+	timings = devm_kcalloc(emc->dev, count, sizeof(*timings), GFP_KERNEL);
+	if (!timings)
+		return -ENOMEM;
+
+	for_each_child_of_node(np, child) {
+		if (!of_device_is_compatible(child, compatible))
+			continue;
+
+		err = tegra210_emc_parse_dt_timing(emc->dev, child, &timings[i++]);
+		if (err < 0) {
+			of_node_put(child);
+			return err;
+		}
+	}
+
+	*timingsp = timings;
+
+	return count;
+}
+
+/*
+ * The bootloader trains only the nominal table; the trimmers are the same
+ * for the derated one (R32's EMC_COPY_TABLE_PARAM_PERIODIC_FIELDS and
+ * EMC_COPY_TABLE_PARAM_TRIM_REGS).
+ */
+static void tegra210_emc_copy_trained(const struct tegra210_emc_timing *src,
+				      struct tegra210_emc_timing *dst)
+{
+	memcpy(dst->trained_dram_clktree, src->trained_dram_clktree,
+	       sizeof(dst->trained_dram_clktree));
+	memcpy(dst->current_dram_clktree, src->current_dram_clktree,
+	       sizeof(dst->current_dram_clktree));
+	memcpy(dst->trim_perch_regs, src->trim_perch_regs,
+	       src->num_trim_per_ch * sizeof(u32));
+	memcpy(dst->trim_regs, src->trim_regs, src->num_trim * sizeof(u32));
+	memcpy(dst->burst_reg_per_ch, src->burst_reg_per_ch,
+	       src->num_burst_per_ch * sizeof(u32));
+	dst->trained = src->trained;
+}
+
+static int tegra210_emc_parse_dt_tables(struct tegra210_emc *emc,
+					struct device_node *np)
+{
+	static const char * const compatibles[][2] = {
+		{ "nvidia,tegra210-emc-table", "nvidia,tegra210-emc-table-derated" },
+		{ "nvidia,tegra21-emc-table", "nvidia,tegra21-emc-table-derated" },
+	};
+	struct device_node *tables = NULL, *child;
+	u32 ram_code = tegra_read_ram_code(), value;
+	int num_nominal = 0, num_derated, err;
+	unsigned int i;
+
+	if (of_property_read_bool(np, "nvidia,use-ram-code")) {
+		for_each_child_of_node(np, child) {
+			if (!of_property_read_u32(child, "nvidia,ram-code", &value) &&
+			    value == ram_code) {
+				tables = child;
+				break;
+			}
+		}
+
+		if (!tables) {
+			dev_err(emc->dev, "no EMC tables for RAM code %u\n", ram_code);
+			return -ENODEV;
+		}
+	} else {
+		tables = of_node_get(np);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(compatibles); i++) {
+		num_nominal = tegra210_emc_parse_dt_set(emc, tables, compatibles[i][0],
+							&emc->nominal);
+		if (num_nominal)
+			break;
+	}
+
+	if (num_nominal <= 0) {
+		err = num_nominal ?: -ENODEV;
+		goto put;
+	}
+
+	num_derated = tegra210_emc_parse_dt_set(emc, tables, compatibles[i][1],
+						&emc->derated);
+	if (num_derated < 0) {
+		err = num_derated;
+		goto put;
+	}
+
+	if (num_derated && num_derated != num_nominal) {
+		dev_err(emc->dev, "%d derated vs. %d nominal EMC timings\n",
+			num_derated, num_nominal);
+		err = -EINVAL;
+		goto put;
+	}
+
+	emc->num_timings = num_nominal;
+
+	for (i = 0; emc->derated && emc->dram_type == DRAM_TYPE_LPDDR4 &&
+		    i < emc->num_timings; i++)
+		tegra210_emc_copy_trained(&emc->nominal[i], &emc->derated[i]);
+
+	dev_info(emc->dev, "EMC tables from %pOF (RAM code %u): %d nominal, %d derated\n",
+		 tables, ram_code, num_nominal, num_derated);
+
+	for (i = 0; i < emc->num_timings; i++)
+		dev_info(emc->dev, "%u kHz: revision %#x, needs training %#x, trained %u\n",
+			 emc->nominal[i].rate, emc->nominal[i].revision,
+			 emc->nominal[i].needs_training, emc->nominal[i].trained);
+
+	err = 0;
+
+put:
+	of_node_put(tables);
+	return err;
+}
