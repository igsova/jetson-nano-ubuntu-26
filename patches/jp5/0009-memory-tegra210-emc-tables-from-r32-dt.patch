+/*
+ * JetPack 4 (L4T R32) device trees carry the EMC tables as nodes under the
+ * EMC node, one set per RAM code, with the fields of struct
+ * tegra210_emc_timing. The bootloader stores its training results in them;
+ * U-Boot copies the node into a device tree loaded from a file. Read them
+ * when no table was passed in reserved memory. This reads what R32's
+ * tegra210-dt-parse.c reads, but fails on a missing property or an oversized
+ * register count instead of logging it and carrying on.
+ */
+struct tegra210_emc_dt_u32 {
+	const char *name;
+	size_t offset;
+	u32 min_revision;
+};
+
+#define EMC_DT_U32(_name, _field, _revision) \
+	{ _name, offsetof(struct tegra210_emc_timing, _field), _revision }
+
