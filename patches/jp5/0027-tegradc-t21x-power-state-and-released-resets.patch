diff --git a/nvidia/drivers/video/tegra/dc/sor.h b/nvidia/drivers/video/tegra/dc/sor.h
index 2a0d65641..8bd8e82f7 100644
--- a/nvidia/drivers/video/tegra/dc/sor.h
+++ b/nvidia/drivers/video/tegra/dc/sor.h
@@ -565,16 +565,59 @@ static inline void tegra_sor_safe_clk_disable(struct tegra_dc_sor_data *sor)
 		clk_disable_unprepare(sor->safe_clk);
 }
 
+#if KERNEL_VERSION(5, 4, 0) <= LINUX_VERSION_CODE
+/*
+ * On 5.4 and later the PMC's SOR power domain lists this reset too, and it
+ * must acquire the reset to power the partition off, which fails with -EBUSY
+ * while another exclusive control holds it. So get it released and acquire it
+ * only around each use (upstream's tegra-drm SOR driver also gets it released
+ * and gives it up before its domain powers off). While the partition is off
+ * the PMC holds it asserted, and powering the partition on deasserts it.
+ */
+static inline int tegra_sor_reset_acquire(struct tegra_dc_sor_data *sor)
+{
+	int err = reset_control_acquire(sor->rst);
+
+	if (err)
+		dev_warn(&sor->dc->ndev->dev,
+			"sor%d: reset held by its power domain (%d), skipped\n",
+			sor->ctrl_num, err);
+	return err;
+}
+
+static inline void tegra_sor_reset_release(struct tegra_dc_sor_data *sor)
+{
+	reset_control_release(sor->rst);
+}
+#else
+static inline int tegra_sor_reset_acquire(struct tegra_dc_sor_data *sor)
+{
+	return 0;
+}
+
+static inline void tegra_sor_reset_release(struct tegra_dc_sor_data *sor)
+{
+}
+#endif
+
 static inline int tegra_get_sor_reset_ctrl(struct tegra_dc_sor_data *sor,
 	struct device_node *np_sor, const char *res_name)
 {
+#if KERNEL_VERSION(5, 4, 0) <= LINUX_VERSION_CODE
+	sor->rst = __of_reset_control_get(np_sor, res_name, 0, false, false,
+					  false);
+#else
 	sor->rst = of_reset_control_get(np_sor, res_name);
+#endif
 	if (IS_ERR(sor->rst)) {
 		dev_err(&sor->dc->ndev->dev,
 			"Unable to get %s reset control\n", res_name);
 		return PTR_ERR(sor->rst);
 	}
-	reset_control_deassert(sor->rst);
+	if (!tegra_sor_reset_acquire(sor)) {
+		reset_control_deassert(sor->rst);
+		tegra_sor_reset_release(sor);
+	}
 	return 0;
 }
 
@@ -584,11 +627,12 @@ static inline void tegra_sor_reset(struct tegra_dc_sor_data *sor)
 		return;
 
 	down_write(&sor->reset_lock);
-	if (sor->rst) {
+	if (sor->rst && !tegra_sor_reset_acquire(sor)) {
 		reset_control_assert(sor->rst);
 		mdelay(2);
 		reset_control_deassert(sor->rst);
 		mdelay(1);
+		tegra_sor_reset_release(sor);
 	}
 	up_write(&sor->reset_lock);
 }
