--- a/nvidia/drivers/video/tegra/host/nvhost_sync_v2.h
+++ b/nvidia/drivers/video/tegra/host/nvhost_sync_v2.h
@@ -23,4 +23,6 @@ struct dma_fence *nvhost_dma_fence_create(
 	struct nvhost_syncpt *syncpt, struct nvhost_ctrl_sync_fence_info *pts,
 	int num_pts);
 
+void nvhost_dma_fence_register_r32(void);
+
 #endif /* __NVHOST_SYNC_V2_H */
